# .env.example — canonical list of environment variables e-agent expects
#
# Usage:
#   cp .env.example .env   # then fill in real values
#   # .env is git-ignored — NEVER commit real keys.

# ─── Anthropic ────────────────────────────────────────────────────────────────
# Your Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# ─── GitHub ───────────────────────────────────────────────────────────────────
# GitHub personal access token (for MCP GitHub server)
# Get one: GitHub → Settings → Developer settings → Personal access tokens
GITHUB_USER="your-github-username"
GITHUB_TOKEN=
GITHUB_PERSONAL_ACCESS_TOKEN=

# Postman workspaces/collections (local server; the remote one uses OAuth, no key)
# Get one: Postman → Settings → API keys
POSTMAN_API_KEY=

# ─── Application (planned stack) ─────────────────────────────────────────────
# Add the app's own variables here once it exists (API base URLs, third-party
# service keys, etc.). Validate all external input with Zod at the boundary.
